{
  "name": "@bebopdev/admin",
  "version": "0.1.0-beta.0",
  "description": "First-party React admin UI for Bebop collections on Jazz.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reezerdev/bebop.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/reezerdev/bebop#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.types.json",
    "prepack": "pnpm run build",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "react-router-dom": ">=6",
    "jazz-tools": "2.0.0-alpha.58"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.468.0",
    "react-hook-form": "^7.89.0"
  },
  "devDependencies": {
    "jazz-tools": "2.0.0-alpha.58",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
