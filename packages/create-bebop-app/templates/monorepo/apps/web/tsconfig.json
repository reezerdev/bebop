{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "types": ["vite/client"]
  },
  "include": [
    "src", "bebop.config.ts", "vite.config.ts", "schema.ts",
    "bebop-generated-schema.ts", "bebop-admin-manifest.ts",
    "bebop-generated-client.ts", "permissions.ts",
    "bebop-generated-command-permissions.ts", "routeTree.gen.ts"
  ]
}
