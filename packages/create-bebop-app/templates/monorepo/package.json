{
  "name": "my-bebop-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.6.0",
  "engines": { "node": ">=22.13.0", "pnpm": ">=12.6.0" },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "generate": "turbo run generate --filter=web",
    "validate:schema": "turbo run validate:schema --filter=web",
    "check": "turbo run check",
    "ios": "pnpm --filter mobile ios",
    "android": "pnpm --filter mobile android"
  },
  "devDependencies": { "turbo": "2.11.4" }
}
