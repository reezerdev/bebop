{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".output/**"] },
    "dev": { "cache": false, "persistent": true },
    "generate": { "cache": false },
    "validate:schema": { "cache": false },
    "check": { "dependsOn": ["^check"], "outputs": [] }
  }
}
